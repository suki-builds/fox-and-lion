          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "published_at": {
        "config": {
          "label": "Published At",
          "placeholder": ""
        },
        "type": "Timestamp"
      },
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": ""
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": ""
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {},
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      },
