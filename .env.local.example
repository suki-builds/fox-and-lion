# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real API tokens.

# Prismic > Settings > General — your repository's subdomain
# (https://<this>.prismic.io)
NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=

# Optional: only needed if the Prismic repository is set to private.
# Prismic > Settings > API & Security > Access Tokens (read-only)
PRISMIC_ACCESS_TOKEN=

# Supabase project URL and anon key — Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key, same settings page. Server-only, used by
# lib/supabase/admin.ts. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the site's canonical URL, used for metadata and share images.
# Defaults to https://foxandlion.pub.
NEXT_PUBLIC_SITE_URL=

# A secret you make up, entered as the Prismic webhook's secret and checked
# by /api/revalidate. See README.md. Generate one with:
#   openssl rand -hex 32
REVALIDATE_SECRET=

# A secret you make up. Vercel Cron sends it when calling /api/sync-jobs
# (see vercel.json). Generate one the same way.
CRON_SECRET=
