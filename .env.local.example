# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real API tokens.

# Prismic > Settings > General — your repository's subdomain
# (https://<this>.prismic.io)
NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=

# Optional: only needed if the Prismic repository is set to private.
# Prismic > Settings > API & Security > Access Tokens (read-only)
PRISMIC_ACCESS_TOKEN=

# Supabase project URL and anon key — Supabase > Project Settings > API.
# Used by lib/formsSupabase.js for the pitch/contact form tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A secret string you make up yourself, used to secure the /api/preview route
PREVIEW_SECRET=

# A secret string you make up yourself, checked against the X-Revalidate-Secret
# header on incoming requests to /api/revalidate (Prismic webhooks). See
# README.md for exact webhook setup. Generate one with:
#   openssl rand -hex 32
REVALIDATE_SECRET=
